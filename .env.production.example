# -----------------------------------------------------------------------------
# Application Environment
# -----------------------------------------------------------------------------
NODE_ENV=production
PORT=4000
TRUST_PROXY=1

# Example: https://learn.example.com or http://123.45.67.89
CLIENT_URL=https://your-domain.com

# -----------------------------------------------------------------------------
# MongoDB (Database)
# -----------------------------------------------------------------------------
MONGO_INITDB_ROOT_USERNAME=lms_admin
MONGO_INITDB_ROOT_PASSWORD=your_mongo_password_here
MONGO_INITDB_DATABASE=lmsdb

# MongoDB connection string for the API container (uses internal hostname 'mongo')
MONGO_URI=mongodb://lms_admin:your_mongo_password_here@mongo:27017/lmsdb?authSource=admin

# -----------------------------------------------------------------------------
# Redis (Cache & BullMQ)
# -----------------------------------------------------------------------------
REDIS_PASSWORD=your_redis_password_here
REDIS_URL=redis://:your_redis_password_here@redis:6379

# -----------------------------------------------------------------------------
# RabbitMQ (Video Transcoding Task Queue)
# -----------------------------------------------------------------------------
RABBITMQ_DEFAULT_USER=lms_queue_admin
RABBITMQ_DEFAULT_PASS=your_rabbitmq_password_here
RABBITMQ_URL=amqp://lms_queue_admin:your_rabbitmq_password_here@rabbitmq:5672

# -----------------------------------------------------------------------------
# JWT Secrets (Generate with: node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))")
# -----------------------------------------------------------------------------
JWT_ACCESS_SECRET=your_jwt_access_secret_here
JWT_REFRESH_SECRET=your_jwt_refresh_secret_here
JWT_ACCESS_EXPIRES=15m
JWT_REFRESH_EXPIRES=7d
JWT_ISSUER=lms-api
JWT_AUDIENCE=lms-client

# -----------------------------------------------------------------------------
# Cloudflare R2 Storage (Private bucket for protected lesson videos)
# -----------------------------------------------------------------------------
R2_ACCOUNT_ID=your_r2_account_id
R2_ACCESS_KEY_ID=your_r2_access_key_id
R2_SECRET_ACCESS_KEY=your_r2_secret_access_key
R2_BUCKET_NAME=lms
R2_PUBLIC_URL=https://your_r2_public_domain.r2.dev

# -----------------------------------------------------------------------------
# First Admin Bootstrap (Used when running `npm run seed:admin`)
# -----------------------------------------------------------------------------
ADMIN_BOOTSTRAP_USERNAME=admin
ADMIN_BOOTSTRAP_EMAIL=admin@example.com
# Password must be >= 12 chars with uppercase, lowercase, and numbers
ADMIN_BOOTSTRAP_PASSWORD=AdminP@ssw0rd2026!

# -----------------------------------------------------------------------------
# AI Quiz & Assessment Generation (Google Gemini)
# -----------------------------------------------------------------------------
GEMINI_API_KEY=your_gemini_api_key_here

# -----------------------------------------------------------------------------
# Frontend (Next.js Client) Public & Internal Variables
# -----------------------------------------------------------------------------
# Public API URL used by the user's browser (points to your domain with Nginx)
NEXT_PUBLIC_API_URL=https://your-domain.com
NEXT_PUBLIC_WHATSAPP_NUMBER=+249901522299

# Internal API URL used by Next.js server-side calls / rewrites inside Docker
INTERNAL_API_URL=http://api:4000
