# =============================================================================
# LMS PRODUCTION ENVIRONMENT VARIABLES (.env.production)
#
# INSTRUCTIONS:
# 1. Copy this file on your VPS:
#      cp .env.production.example .env.production
# 2. Fill in all passwords and API keys. NEVER commit .env.production to Git!
# =============================================================================

# -----------------------------------------------------------------------------
# Application Environment
# -----------------------------------------------------------------------------
NODE_ENV=production
PORT=4000

# Set to 1 because Nginx sits in front of Express as a reverse proxy
TRUST_PROXY=1

# Public URL of the frontend / domain (no trailing slash). Wildcards are rejected.
# Example: https://learn.example.com or http://123.45.67.89
CLIENT_URL=https://athareducational.com

# -----------------------------------------------------------------------------
# MongoDB (Database)
# Replace with strong generated passwords
# -----------------------------------------------------------------------------
MONGO_INITDB_ROOT_USERNAME=lms_admin
MONGO_INITDB_ROOT_PASSWORD=replace_with_strong_mongo_password_here
MONGO_INITDB_DATABASE=lmsdb

# MongoDB connection string for the API container (uses internal hostname 'mongo')
MONGO_URI=mongodb://lms_admin:replace_with_strong_mongo_password_here@mongo:27017/lmsdb?authSource=admin

# -----------------------------------------------------------------------------
# Redis (Cache & BullMQ)
# -----------------------------------------------------------------------------
REDIS_PASSWORD=replace_with_strong_redis_password_here
REDIS_URL=redis://:replace_with_strong_redis_password_here@redis:6379

# -----------------------------------------------------------------------------
# RabbitMQ (Video Transcoding Task Queue)
# -----------------------------------------------------------------------------
RABBITMQ_DEFAULT_USER=lms_queue_admin
RABBITMQ_DEFAULT_PASS=replace_with_strong_rabbitmq_password_here
RABBITMQ_URL=amqp://lms_queue_admin:replace_with_strong_rabbitmq_password_here@rabbitmq:5672

# -----------------------------------------------------------------------------
# JWT Security (CRITICAL)
# Must be base64url strings, >= 43 characters, and completely DIFFERENT!
# Generate each with:
#   node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"
# -----------------------------------------------------------------------------
JWT_ACCESS_SECRET=replace_with_generated_random_base64url_secret_1
JWT_REFRESH_SECRET=replace_with_generated_random_base64url_secret_2
JWT_ACCESS_EXPIRES=15m
JWT_REFRESH_EXPIRES=7d
JWT_ISSUER=lms-api
JWT_AUDIENCE=lms-client

# -----------------------------------------------------------------------------
# Cloudflare R2 Storage (Private bucket for protected lesson videos)
# -----------------------------------------------------------------------------
R2_ACCOUNT_ID=your_cloudflare_account_id
R2_ACCESS_KEY_ID=your_r2_access_key_id
R2_SECRET_ACCESS_KEY=your_r2_secret_access_key
R2_BUCKET_NAME=your_r2_bucket_name

# -----------------------------------------------------------------------------
# First Admin Bootstrap (Used when running `npm run seed:admin`)
# -----------------------------------------------------------------------------
ADMIN_BOOTSTRAP_USERNAME=Hassan
ADMIN_BOOTSTRAP_EMAIL=admin@gmail.com
# Password must be >= 12 chars with uppercase, lowercase, and numbers
ADMIN_BOOTSTRAP_PASSWORD=AdminP@ssw0rd2026!

# -----------------------------------------------------------------------------
# AI Quiz & Assessment Generation (Google Gemini)
# -----------------------------------------------------------------------------
GEMINI_API_KEY=your_gemini_api_key_here

# -----------------------------------------------------------------------------
# Frontend (Next.js Client) Public & Internal Variables
# -----------------------------------------------------------------------------
# Public API URL used by the user's browser.
# If using Nginx reverse proxy on the same domain, use your domain URL:
NEXT_PUBLIC_API_URL=https://athareducational.com
NEXT_PUBLIC_WHATSAPP_NUMBER=+249901522299

# Internal API URL used by Next.js server-side calls / rewrites inside Docker
INTERNAL_API_URL=http://api:4000
